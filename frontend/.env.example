# Copy to frontend/.env.local and fill in once the Firebase web app is created
# (Phase 1). The web API key is not a secret but is environment-specific.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=agentforge-498808.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agentforge-498808
VITE_FIREBASE_APP_ID=

# Optional: call the deployed Cloud Run API directly (real Gemini / real Firestore).
# Leave unset to use the local backend via the Vite dev proxy.
# VITE_API_BASE=https://agentforge-core-api-217469091476.asia-northeast1.run.app
