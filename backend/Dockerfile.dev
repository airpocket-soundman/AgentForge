# AgentForge backend — LOCAL DEV image (hot reload). Production uses ./Dockerfile.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install deps first (layer cache). App code is bind-mounted by docker-compose,
# so we don't COPY it here — edits on the host trigger uvicorn --reload.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --reload"]
