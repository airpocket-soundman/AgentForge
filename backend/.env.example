# Copy to backend/.env for local runs OUTSIDE docker-compose.
# (docker-compose.dev.yml sets these directly, so you don't need this file for it.)
GOOGLE_CLOUD_PROJECT=agentforge-498808
GOOGLE_CLOUD_REGION=asia-northeast1

# Point at the local Firestore emulator (host:port). Leave UNSET to use real Firestore.
FIRESTORE_EMULATOR_HOST=localhost:8081

# Gemini is wired in Phase 2. Never commit a real key — use Secret Manager in prod.
# GEMINI_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
